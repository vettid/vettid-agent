<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template, used by scripts/build-macos-app (AGENT-PLAN §6 A5.3). The
  entitlements of vettid-agent.app: the
  keychain-access-groups entitlement is what lets the Keychain protector
  (internal/protect/keychain.go) use the data protection keychain. macOS
  honours it only in a binary signed with the owner's Developer ID whose
  embedded provisioning profile (Contents/embedded.provisionprofile)
  allows the same App ID and access group; a binary signed with these
  entitlements but no such profile is stopped at launch.

  TEAMID is replaced by the owner's Apple Developer Team ID (-t or
  APPLE_TEAM_ID, never committed); org.vettid.agent is the App ID.
-->
<plist version="1.0">
<dict>
	<key>com.apple.application-identifier</key>
	<string>TEAMID.org.vettid.agent</string>
	<key>com.apple.developer.team-identifier</key>
	<string>TEAMID</string>
	<key>keychain-access-groups</key>
	<array>
		<string>TEAMID.org.vettid.agent</string>
	</array>
</dict>
</plist>
