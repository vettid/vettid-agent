#!/usr/bin/env bash
# Rebuild a release from source and compare it with its SHA256SUMS
# (AGENT-PLAN §2 AG4, §6 A5.1).
#
#   scripts/verify-reproducible [-m] [-k] [-o FILE] REF SHA256SUMS
#
# REF is the release tag (for example v0.1.0) or a commit; SHA256SUMS is
# the file published with the release (or written by another build). In a
# signed SHA256SUMS (scripts/sign-release) the first line,
# "# vettid-agent-release/<version>/<commit>", must name REF's version and
# commit, and the macOS app's line (vettid-agent-<version>-darwin-arm64.zip,
# built and notarized on the owner's Mac, not reproducible) is left out of
# the comparison and said so; scripts/verify-release checks the signature.
# The script clones this repository into a new temporary directory,
# checks out REF there, and runs REF's own scripts/build-release in that
# clone with a fresh build cache (REF is passed through, so a version
# tag builds as that version even if its commit carries other tags).
# Then, with this checkout's own tools rather than REF's, it hashes the
# rebuilt binaries, checks them with this checkout's
# scripts/check-release-binaries (toolchain from REF's go.mod, version
# and commit from REF), and compares the hashes with SHA256SUMS: the same
# file names and the same hashes, nothing more and nothing less. On
# Linux amd64 and arm64 it also runs the binary for this machine and
# requires `version` to name REF's version and commit. It exits 0 only if
# everything matches, and 1 on any difference (printed as a diff).
#
# Before running REF's scripts it prints how REF's scripts/ differ from
# this checkout's, for the reader to judge. REF's scripts run as the
# calling user: run this in a container or a throwaway VM.
#
#   -m  also use a fresh Go module cache (downloads the toolchain and
#       every module again, checksum-verified against go.sum and the Go
#       checksum database)
#   -k  keep the temporary directory and say where it is
#   -o FILE  also write the rebuilt binaries' hashes to FILE when they
#       match: the line "# vettid-agent-rebuild/<version>/<commit>", then
#       sha256sum lines sorted by name. scripts/sign-release --rebuilt
#       takes it from a rebuild made on another machine, and requires
#       that first line (so a release's own SHA256SUMS is not mistaken
#       for a rebuild).
#
# Fetch the release tag first (git fetch --tags). Checking the owner's
# signature over SHA256SUMS is a separate step: scripts/verify-release
# (README, "Verifying a release").
set -euo pipefail

usage() { echo "usage: scripts/verify-reproducible [-m] [-k] [-o FILE] REF SHA256SUMS" >&2; exit 2; }
log() { echo "verify-reproducible: $*" >&2; }

fresh_modcache=0
keep=0
outfile=""
while getopts "mko:" opt; do
  case "$opt" in
    m) fresh_modcache=1 ;;
    k) keep=1 ;;
    o) outfile="$OPTARG" ;;
    *) usage ;;
  esac
done
shift $((OPTIND - 1))
[ "$#" -eq 2 ] || usage
ref="$1"
sums="$(cd "$(dirname "$2")" && pwd)/$(basename "$2")"
[ -f "$sums" ] || { log "FAIL $2 is not a file"; exit 1; }
if [ -n "$outfile" ]; then
  outfile="$(cd "$(dirname "$outfile")" && pwd)/$(basename "$outfile")"
fi

repo="$(cd "$(dirname "$0")/.." && pwd)"
verre='^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?$'
if [[ "$ref" =~ $verre ]] && git -C "$repo" rev-parse --verify --quiet --end-of-options "refs/tags/$ref" >/dev/null; then
  commit="$(git -C "$repo" rev-parse --verify --quiet --end-of-options "refs/tags/$ref^{commit}")" || { log "FAIL tag $ref is not a commit"; exit 1; }
  build_ref="$ref"
  version="$ref"
else
  commit="$(git -C "$repo" rev-parse --verify --quiet --end-of-options "${ref}^{commit}")" || { log "FAIL $ref is not a commit here (git fetch --tags?)"; exit 1; }
  build_ref="$commit"
  version="untagged"
fi

work="$(mktemp -d "${TMPDIR:-/tmp}/vettid-agent-verify.XXXXXXXX")"
cleanup() {
  cd /
  if [ "$keep" = 1 ]; then log "kept $work"; return; fi
  chmod -R u+w "$work" 2>/dev/null || true
  rm -rf "$work"
}
trap cleanup EXIT

log "cloning into $work/repo"
git clone --quiet --no-local --no-checkout "$repo" "$work/repo"
git -C "$work/repo" -c advice.detachedHead=false checkout --quiet "$commit"
if [ "$fresh_modcache" = 1 ]; then
  export GOMODCACHE="$work/gomodcache"
fi
# Shown before REF's scripts run: what REF's build script does that this
# checkout's does not. REF's scripts run as the calling user (README:
# verify in a container or a throwaway VM).
log "REF's scripts/ compared with this checkout's (informational; - REF, + this checkout):"
diff -ru "$work/repo/scripts" "$repo/scripts" >&2 || true

# REF's own build script, in the clone; nothing from the caller's
# environment selects the version.
(unset VETTID_RELEASE_VERSION; TMPDIR="$work" "$work/repo/scripts/build-release" -o "$work/out" "$build_ref")

# From here on, this checkout's tools only.
cd "$work/out"
bins=()
for f in vettid-agent-*; do [ -f "$f" ] && bins+=("$f"); done
[ "${#bins[@]}" -gt 0 ] || { log "FAIL the rebuild produced no binaries"; exit 1; }
toolchain="$(awk '$1 == "toolchain" { print $2 }' "$work/repo/go.mod")"
if ! "$repo/scripts/check-release-binaries" -t "$toolchain" -v "$version" -c "$commit" "${bins[@]}"; then
  log "FAIL the rebuilt binaries are not release builds of $ref ($commit)"
  exit 1
fi
# The binary for this machine, if one was built, says the same version and
# commit (Linux amd64 and arm64; elsewhere this step is skipped).
host=""
case "$(uname -s)/$(uname -m)" in
  Linux/x86_64|Linux/amd64) host="linux-amd64" ;;
  Linux/aarch64|Linux/arm64) host="linux-arm64" ;;
esac
if [ -n "$host" ] && [ -f "vettid-agent-$version-$host" ]; then
  got="$("./vettid-agent-$version-$host" version)" || { log "FAIL vettid-agent-$version-$host version failed"; exit 1; }
  want="$(printf 'vettid-agent %s\ncommit: %s' "$version" "$commit")"
  if [ "$(printf '%s\n' "$got" | head -n2)" != "$want" ] || [ "$(printf '%s\n' "$got" | grep -c '^build:' || true)" != 0 ]; then
    log "FAIL vettid-agent-$version-$host version says:"
    printf '%s\n' "$got" >&2
    log "expected it to begin with:"
    printf '%s\n' "$want" >&2
    exit 1
  fi
  log "vettid-agent-$version-$host version: $version, commit $commit"
else
  log "no binary for this machine ($(uname -s)/$(uname -m)); not running \`version\`"
fi

if command -v sha256sum >/dev/null; then
  sha256sum "${bins[@]}" | LC_ALL=C sort -k2 >"$work/rehashed"
else
  shasum -a 256 "${bins[@]}" | LC_ALL=C sort -k2 >"$work/rehashed"
fi
if ! cmp -s "$work/rehashed" "$work/out/SHA256SUMS"; then
  log "note: REF's build-release wrote a SHA256SUMS that differs from the hashes of its files; comparing the hashes computed here"
fi

# The lines to compare: a signed SHA256SUMS without its "#" line and the
# macOS app's line.
given="$work/given"
if [ "$(head -c1 "$sums")" = "#" ]; then
  first="$(head -n1 "$sums")"
  [ "$first" = "# vettid-agent-release/$version/$commit" ] || { log "FAIL $2 begins with \"$first\", not \"# vettid-agent-release/$version/$commit\""; exit 1; }
  log "$2 is signed for $version at $commit"
fi
grep -v '^#' "$sums" | grep -vE "^[0-9a-f]{64}  vettid-agent-$version-darwin-arm64\.zip\$" >"$given" || true
if grep -qE "^[0-9a-f]{64}  vettid-agent-$version-darwin-arm64\.zip\$" "$sums"; then
  log "not compared: vettid-agent-$version-darwin-arm64.zip (the macOS app, built and notarized on the owner's Mac; not reproducible)"
fi

if diff -u "$given" "$work/rehashed"; then
  if [ -n "$outfile" ]; then
    { echo "# vettid-agent-rebuild/$version/$commit"; cat "$work/rehashed"; } >"$outfile"
    log "wrote the rebuilt hashes to $outfile"
  fi
  log "PASS $ref ($commit) rebuilds to the hashes in $2"
else
  log "FAIL the rebuild of $ref ($commit) differs from $2 (- given, + rebuilt)"
  exit 1
fi
